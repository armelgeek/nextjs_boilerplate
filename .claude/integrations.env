# Drift Integrations Configuration
# 🎯 DEFAULT: GitHub-Native (Discussions + Wiki + Issues)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Notifications (Standup, Alerts) ───────────────────────────────────────
# DEFAULT: GitHub Discussions ⭐

NOTIFICATION_SERVICE=github
GITHUB_REPO=username/repo  # SET THIS: e.g., armelgeek5/hayzar-boilerplate
GITHUB_TOKEN=              # SET THIS: ghp_xxxxxxxxxxxx

# To switch to other services, uncomment and set:

# Slack
# NOTIFICATION_SERVICE=slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Discord
# NOTIFICATION_SERVICE=discord
# DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...

# Teams
# NOTIFICATION_SERVICE=teams
# TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/webhookb2/...

# Email
# NOTIFICATION_SERVICE=email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=
# EMAIL_TO=team@example.com


# ─── Knowledge Base (PRDs, Documentation) ──────────────────────────────────
# DEFAULT: GitHub Wiki ⭐

DOCS_SERVICE=github_wiki
# GITHUB_REPO and GITHUB_TOKEN already set above

# To switch to other services, uncomment and set:

# Notion
# DOCS_SERVICE=notion
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=abc123...

# Confluence
# DOCS_SERVICE=confluence
# CONFLUENCE_URL=https://company.atlassian.net
# CONFLUENCE_USERNAME=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE_KEY=

# Local Markdown (git-only)
# DOCS_SERVICE=local
# DOCS_PATH=./docs

# Obsidian vault
# DOCS_SERVICE=obsidian
# OBSIDIAN_VAULT_PATH=/Users/username/Obsidian/MyVault


# ─── Issue Tracking ────────────────────────────────────────────────────────
# DEFAULT: GitHub Issues (built-in)

ISSUE_SERVICE=github
# GITHUB_REPO and GITHUB_TOKEN already set above

# To switch to Linear:
# ISSUE_SERVICE=linear
# LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM_ID=team_...


# ─── Analytics & Metrics ───────────────────────────────────────────────────

POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional: Custom metrics dashboard
# METRICS_DASHBOARD_URL=https://your-dashboard.com


# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
#
# 1. Set GITHUB_REPO: yourusername/yourrepo
# 2. Generate GITHUB_TOKEN:
#    - https://github.com/settings/tokens
#    - Scopes: repo, discussions, workflow
#    - Copy and paste here
# 3. Enable Discussions in repo settings
# 4. Test: source this file, then /standup
#
# That's it! Everything runs on GitHub now. 🚀
# ─────────────────────────────────────────────────────────────────────────────
